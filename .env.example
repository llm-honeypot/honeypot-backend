# Copy to .env and fill in values before starting the service

APP_ENV=production
USE_LLM=true
USE_DYNAMODB=true

# Groq — free at console.groq.com
GROQ_API_KEY=gsk_REPLACE_ME
LLM_MODEL=llama-3.1-8b-instant

# DynamoDB
DYNAMODB_SESSIONS_TABLE=honeypot-sessions
DYNAMODB_EVENTS_TABLE=honeypot-events
DYNAMODB_REGION=us-east-1

# Used to sign fake JWTs served to attackers
JWT_SIGNING_KEY=REPLACE_ME_32_RANDOM_HEX_CHARS
